    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@gwent/shared-types": "workspace:*",
    "@gwent/card-data": "workspace:*",
    "immer": "^10.0.0"
  },
  "devDependencies": {
    "@gwent/typescript-config": "workspace:*",
    "@types/jest": "^29.0.0",
    "@types/node": "^20.0.0",
    "jest": "^29.0.0",
    "ts-jest": "^29.0.0",
    "typescript": "^5.0.0"
  }
}
